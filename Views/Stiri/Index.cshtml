@model IEnumerable<ProiectBigData.Models.StireMedicala>

@{
    ViewData["Title"] = "Noutăți Medicale";
}

<div class="container p-3">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Intervenții Recente & Cazuri de Succes</h1>
        <a asp-action="Create" class="btn btn-primary">Publica o știre nouă</a>
    </div>

    <div class="row">

      <form asp-action="Index" method="get" class="mb-4">
    <div class="input-group shadow-sm">
        
        <input type="text" name="cautare" class="form-control" 
               placeholder="Caută titlu sau medic..." 
               value="@ViewData["CautareCurenta"]" style="width: 40%;">

        <select name="spitalId" class="form-select" asp-items="ViewBag.SpitalId" style="width: 30%;">
            <option value="">-- Toate Spitalele --</option>
        </select>
        
        <button class="btn btn-primary" type="submit">
            <i class="bi bi-search"></i> Filtrează
        </button>
        
        @if (ViewData["CautareCurenta"] != null || ViewBag.SpitalId?.SelectedValue != null)
        {
            <a asp-action="Index" class="btn btn-secondary">Reset</a>
        }
    </div>
</form>

        @foreach (var item in Model)
        {
            <div class="col-md-6 mb-4">
                <div class="card h-100 shadow-sm">
                    <div class="card-header bg-white border-bottom-0 pt-3">
                        <div class="d-flex justify-content-between">
                            <span class="badge bg-info text-dark">
                                @item.Doctor.Specializare?.Nume
                            </span>
                            <small class="text-muted">@item.DataPublicarii.ToString("dd MMM yyyy")</small>
                        </div>
                        <h4 class="card-title mt-2 text-primary">@item.Titlu</h4>
                    </div>

                    <div class="card-body">
                        <p class="card-text">@item.Descriere</p>
                    </div>

                    <div class="card-footer bg-light">
                        <div class="d-flex align-items-center">
                            <div>
                                <h6 class="mb-0 fw-bold">Dr. @item.Doctor.Nume</h6>
                                <small class="text-muted">
                                    <i class="bi bi-hospital"></i>Spital: @item.Doctor.Spital.Nume
                                </small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>