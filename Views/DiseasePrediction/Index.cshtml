@model ProiectBigData.Models.DiseasePredictionViewModel

@{
    ViewData["Title"] = "Predicție Boală";
}

<div class="container mt-5">
    <h2>Predicție Boală</h2>
    <hr />

    <form asp-action="Index" method="post">
        <div class="form-group mb-3">
            <label class="form-label fw-bold">Descrie Simptomele (în engleză):</label>
            <textarea asp-for="Text" class="form-control" rows="3" placeholder="Ex: I feel dizzy and have a headache..."></textarea>
            <span asp-validation-for="Text" class="text-danger"></span>
        </div>
        <button type="submit" class="btn btn-primary">Analizează Simptomul</button>
    </form>

    @if (!string.IsNullOrEmpty(Model.PredictedLabel))
    {
        <div class="alert alert-info mt-4 shadow-sm">
            <h4 class="alert-heading">Rezultat Diagnostic:</h4>
            <p class="display-6 mb-0">
                <i class="bi bi-activity"></i> @Model.PredictedLabel
            </p>
        </div>
    }
</div>