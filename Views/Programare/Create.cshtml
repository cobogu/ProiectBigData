@model ProiectBigData.Models.Programare

@{
    ViewData["Title"] = "Programare Nouă";
}

<h2>Fă o programare</h2>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group mb-3">
                <label asp-for="NumePacient" class="control-label"></label>
                <input asp-for="NumePacient" class="form-control" placeholder="Introduceți numele dvs." />
                <span asp-validation-for="NumePacient" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Data" class="control-label"></label>
                <input asp-for="Data" class="form-control" />
                <span asp-validation-for="Data" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label class="control-label">Alegeți Doctorul</label>
                <select asp-for="DoctorId" class="form-control" asp-items="ViewBag.DoctorId">
                    <option value="">-- Selectați un medic --</option>
                </select>
                <span asp-validation-for="DoctorId" class="text-danger"></span>
            </div>

            <div class="form-group">
                <input type="submit" value="Rezervă Locul" class="btn btn-success" />
                <a asp-action="Index" class="btn btn-secondary">Înapoi la listă</a>
            </div>
        </form>
    </div>
</div>